  "map-tools": "\n            <button type=\"button\" id=\"toolWall\" class=\"tool-btn\" data-tool=\"wall\" title=\"Wand setzen: zwei Punkte anklicken\" hidden><span class=\"tool-ico\" aria-hidden=\"true\">🧱</span><span class=\"tool-label\">Wand</span></button>\n            <button type=\"button\" id=\"toolLight\" class=\"tool-btn\" data-tool=\"light\" title=\"Lichtquelle platzieren: auf die Karte klicken\" hidden><span class=\"tool-ico\" aria-hidden=\"true\">💡</span><span class=\"tool-label\">Licht</span></button>\n            <button type=\"button\" id=\"btnVisionToggle\" class=\"tool-btn active\" title=\"Wand-/Licht-Markierungen ein-/ausblenden\" aria-pressed=\"true\"><span class=\"tool-ico\" aria-hidden=\"true\">👁</span><span class=\"tool-label\">Sicht</span></button>\n            ",
  "session-controls": "\n                    <div class=\"panel\">\n                        <h2>Vorbereitung</h2>\n                        <div class=\"subpanel\">\n                            <h3>Session-Aufbau</h3>\n                            <div class=\"button-row\">\n                                <button type=\"button\" id=\"btnInitStack\" class=\"secondary\">Kartenstapel initialisieren</button>\n                                <button type=\"button\" id=\"btnReadyCheck\" class=\"secondary\">Start-Check</button>\n                            </div>\n                        </div>\n                        <div class=\"subpanel\">\n                            <h3>Session-Steuerung</h3>\n                            <div class=\"button-row\">\n                                <button type=\"button\" id=\"btnToReady\">Bereit setzen</button>\n                                <button type=\"button\" id=\"btnStart\">Live starten</button>\n                                <button type=\"button\" id=\"btnPause\" class=\"secondary\">Pause</button>\n                                <button type=\"button\" id=\"btnResume\">Fortsetzen</button>\n                                <button type=\"button\" id=\"btnEnd\" class=\"danger\">Session beenden</button>\n                            </div>\n                        </div>\n                    </div>\n\n                    <div class=\"panel\">\n                        <h2>Start-Check</h2>\n                        <div id=\"readyCheckOutput\" class=\"muted\">Noch kein Start-Check ausgeführt.</div>\n                    </div>\n                    "
