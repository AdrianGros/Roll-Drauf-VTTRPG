  "visible-tokens": "\n                    <div class=\"button-row\" id=\"tokenVisibleRow\" hidden style=\"margin-bottom:0.45rem;\">\n                        <button type=\"button\" id=\"btnTokenVisible\" class=\"mini-btn secondary\" aria-haspopup=\"true\" aria-expanded=\"false\" aria-controls=\"visibleTokensPopover\">Sichtbare Tokens</button>\n                    </div>\n                    <div id=\"visibleTokensPopover\" class=\"conditions-popover\" role=\"dialog\" aria-label=\"Sichtbare Tokens\" hidden>\n                        <div class=\"conditions-popover-head\">\n                            <strong>Sichtbare Tokens</strong>\n                            <button type=\"button\" id=\"btnVisibleTokensClose\" class=\"mini-btn secondary\" aria-label=\"Schließen\">✕</button>\n                        </div>\n                        <div id=\"visibleTokensList\" class=\"conditions-list\" style=\"grid-template-columns:1fr;\"></div>\n                    </div>\n                    ",
