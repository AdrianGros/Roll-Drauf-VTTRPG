  "layer-add": "\n                    <div id=\"layerAddRow\" class=\"layer-add-row\">\n                        <input id=\"layerAddName\" type=\"text\" maxlength=\"120\" placeholder=\"Name der neuen Seite...\" style=\"flex:1;min-width:0;padding:0.25rem 0.4rem;\">\n                        <button id=\"layerAddBtn\" class=\"mini-btn\" type=\"button\" title=\"Neue Seite anlegen: Karte hochladen oder vorhandene übernehmen\">Hinzufügen</button>\n                    </div>\n                    <div id=\"layerAddChoice\" class=\"layer-add-choice\" hidden>\n                        <div class=\"layer-add-row\">\n                            <button id=\"layerAddUpload\" class=\"mini-btn\" type=\"button\" title=\"Eine Bilddatei als neue Karte hochladen\">Neue Karte hochladen</button>\n                            <label style=\"display:flex;align-items:center;gap:0.3rem;font-size:0.72rem;color:var(--muted);white-space:nowrap;\">\n                                Raster\n                                <input id=\"mapUploadGridSize\" type=\"number\" min=\"16\" max=\"300\" step=\"1\" value=\"70\" style=\"width:60px;padding:0.2rem 0.3rem;\">\n                                px\n                            </label>\n                        </div>\n                        <div class=\"layer-add-row\">\n                            <select id=\"layerAddSource\" style=\"flex:1;min-width:0;\"></select>\n                            <button id=\"layerAddCopy\" class=\"mini-btn secondary\" type=\"button\" title=\"Die gewählte Karte als neue Seite übernehmen (bereits verwendete werden kopiert)\">Übernehmen</button>\n                        </div>\n                        <button id=\"layerAddCancel\" class=\"mini-btn secondary\" type=\"button\">Abbrechen</button>\n                    </div>\n                    ",
  "combat-controls": "\n                    <div class=\"button-row\" id=\"initiativeControls\" style=\"margin:0.45rem 0 0;\" hidden>\n                        <!-- Playtable-Vordermann 2026-08-25: der Kampf läuft\n                             über das getestete Server-Backend (Encounter,\n                             Runden, Züge) statt über den früheren\n                             clientseitigen d20. -->\n                        <button type=\"button\" id=\"btnStartCombat\" class=\"mini-btn\">Kampf starten</button>\n                        <button type=\"button\" id=\"btnNextTurn\" class=\"mini-btn\" hidden>Nächster Zug</button>\n                        <button type=\"button\" id=\"btnEndCombat\" class=\"mini-btn secondary\" hidden>Kampf beenden</button>\n                        <button type=\"button\" id=\"btnRollInitiative\" class=\"mini-btn secondary\">Initiative auswürfeln</button>\n                    </div>\n                    ",
