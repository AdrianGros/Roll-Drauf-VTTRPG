{
  "vision-edit": "\n            <div id=\"wallEditPopover\" class=\"vision-geom-popover\" role=\"dialog\" aria-label=\"Wand bearbeiten\" hidden>\n                <div class=\"button-row\" style=\"margin-bottom:0.4rem;\">\n                    <strong>Wand</strong>\n                    <button type=\"button\" id=\"btnWallEditClose\" class=\"mini-btn secondary\" aria-label=\"Schließen\" style=\"margin-left:auto;\">✕</button>\n                </div>\n                <div class=\"button-row\" style=\"margin-bottom:0.4rem;\">\n                    <label for=\"wallEditSight\" style=\"min-width:60px;\">Sicht</label>\n                    <select id=\"wallEditSight\">\n                        <option value=\"normal\">Blockiert</option>\n                        <option value=\"limited\">Begrenzt</option>\n                        <option value=\"proximity\">Näherung</option>\n                        <option value=\"none\">Frei</option>\n                    </select>\n                </div>\n                <div class=\"button-row\" style=\"margin-bottom:0.4rem;\">\n                    <label for=\"wallEditLight\" style=\"min-width:60px;\">Licht</label>\n                    <select id=\"wallEditLight\">\n                        <option value=\"normal\">Blockiert</option>\n                        <option value=\"ethereal\">Ätherisch</option>\n                        <option value=\"none\">Frei</option>\n                    </select>\n                </div>\n                <div class=\"button-row\">\n                    <button type=\"button\" id=\"btnWallDelete\" class=\"mini-btn danger\">Wand löschen</button>\n                </div>\n            </div>\n\n            <div id=\"lightEditPopover\" class=\"vision-geom-popover\" role=\"dialog\" aria-label=\"Lichtquelle bearbeiten\" hidden>\n                <div class=\"button-row\" style=\"margin-bottom:0.4rem;\">\n                    <strong>Lichtquelle</strong>\n                    <button type=\"button\" id=\"btnLightEditClose\" class=\"mini-btn secondary\" aria-label=\"Schließen\" style=\"margin-left:auto;\">✕</button>\n                </div>\n                <div class=\"button-row\" style=\"margin-bottom:0.4rem;\">\n                    <label for=\"lightEditType\" style=\"min-width:60px;\">Typ</label>\n                    <select id=\"lightEditType\">\n                        <option value=\"light\">Licht</option>\n                        <option value=\"darkness\">Dunkelheit</option>\n                    </select>\n                </div>\n                <div class=\"button-row\" style=\"margin-bottom:0.4rem;\">\n                    <label for=\"lightEditBright\" style=\"min-width:60px;\">Hell</label>\n                    <input id=\"lightEditBright\" type=\"number\" min=\"0\" style=\"width:70px;\">\n                    <label for=\"lightEditDim\" style=\"min-width:40px;\">Dämm.</label>\n                    <input id=\"lightEditDim\" type=\"number\" min=\"0\" style=\"width:70px;\">\n                </div>\n                <div class=\"button-row\" style=\"margin-bottom:0.4rem;\">\n                    <label><input type=\"checkbox\" id=\"lightEditProvidesVision\"> Gewährt Sicht</label>\n                </div>\n                <div class=\"button-row\">\n                    <button type=\"button\" id=\"btnLightDelete\" class=\"mini-btn danger\">Licht löschen</button>\n                </div>\n            </div>\n            ",
