        {
          "text": "Running Leap. With a 10-foot running start, the tiger can Long Jump up to 25 feet.",
          "title": "Traits"
        },
        {
          "text": "Multiattack. The tiger makes two Rend attacks.\nRend. Melee Attack Roll: +6, reach 5 ft. Hit: 11 (2d6 + 4) Slashing damage.",
          "title": "Actions"
        },
        {
          "text": "Nimble Escape. The tiger takes the Disengage or Hide action.",
          "title": "Bonus Actions"
        }
      ],
