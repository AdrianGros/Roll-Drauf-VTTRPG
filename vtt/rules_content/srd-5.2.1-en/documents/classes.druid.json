      "ruleId": "classes.druid.druid-class-features",
      "text": "Druid Class Features",
      "type": "heading"
    },
    {
      "ruleId": "classes.druid.druid-class-features.p-1",
      "text": "As a Druid, you gain the following class features when you reach the specified Druid levels. These features are listed in the Druid Features table.",
      "type": "paragraph"
    },
    {
