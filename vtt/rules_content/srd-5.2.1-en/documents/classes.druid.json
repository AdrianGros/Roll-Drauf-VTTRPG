    {
      "level": 3,
      "ruleId": "classes.druid.druid-subclass-circle-of-the-land",
      "text": "Druid Subclass: Circle of the Land",
      "type": "heading"
    },
    {
      "level": 4,
      "ruleId": "classes.druid.druid-subclass-circle-of-the-land.celebrate-connection-to-the-natural-world",
      "text": "Celebrate Connection to the Natural World",
      "type": "heading"
    },
    {
      "ruleId": "classes.druid.druid-subclass-circle-of-the-land.celebrate-connection-to-the-natural-world.p-1",
      "text": "The Circle of the Land comprises mystics and sages who safeguard ancient knowledge and rites. These Druids meet within sacred circles of trees or standing stones to whisper primal secrets in Druidic. The circle’s wisest members preside as the chief priests of their communities.",
      "type": "paragraph"
    },
    {
      "level": 4,
      "ruleId": "classes.druid.druid-subclass-circle-of-the-land.level-3-circle-of-the-land-spells",
      "text": "Level 3: Circle of the Land Spells",
      "type": "heading"
    },
    {
      "ruleId": "classes.druid.druid-subclass-circle-of-the-land.level-3-circle-of-the-land-spells.p-1",
      "text": "Whenever you finish a Long Rest, choose one type of land: arid, polar, temperate, or tropical. Consult the table below that corresponds to the chosen type; you have the spells listed for your Druid level and lower prepared.",
      "type": "paragraph"
    },
    {
      "caption": "Arid Land",
      "columns": [
        "Druid Level",
        "Circle Spells"
      ],
      "rows": [
        [
          "3",
          "Blur, Burning Hands, Fire Bolt"
        ],
        [
          "5",
          "Fireball"
        ],
        [
