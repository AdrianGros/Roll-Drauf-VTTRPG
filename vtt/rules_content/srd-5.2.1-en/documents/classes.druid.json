      ],
      "ruleId": "classes.druid.druid-subclass-circle-of-the-land.level-3-circle-of-the-land-spells.table-4",
      "type": "table"
    },
    {
      "level": 4,
      "ruleId": "classes.druid.druid-subclass-circle-of-the-land.level-3-lands-aid",
      "text": "Level 3: Land’s Aid",
      "type": "heading"
    },
    {
      "ruleId": "classes.druid.druid-subclass-circle-of-the-land.level-3-lands-aid.p-1",
      "text": "As a Magic action, you can expend a use of your Wild Shape and choose a point within 60 feet of yourself. Vitality-giving flowers and life-draining thorns appear for a moment in a 10-foot-radius Sphere centered on that point. Each creature of your choice in the Sphere must make a Constitution saving throw against your spell save DC, taking 2d6 Necrotic damage on a failed save or half as much damage on a successful one. One creature of your choice in that area regains 2d6 Hit Points.",
      "type": "paragraph"
    },
    {
      "ruleId": "classes.druid.druid-subclass-circle-of-the-land.level-3-lands-aid.p-2",
      "text": "The damage and healing increase by 1d6 when you reach Druid levels 10 (3d6) and 14 (4d6).",
      "type": "paragraph"
    },
    {
      "level": 4,
      "ruleId": "classes.druid.druid-subclass-circle-of-the-land.level-6-natural-recovery",
      "text": "Level 6: Natural Recovery",
      "type": "heading"
    },
    {
      "ruleId": "classes.druid.druid-subclass-circle-of-the-land.level-6-natural-recovery.p-1",
      "text": "You can cast one of the level 1+ spells that you have prepared from your Circle Spells feature without expending a spell slot, and you must finish a Long Rest before you do so again.",
      "type": "paragraph"
    },
    {
      "ruleId": "classes.druid.druid-subclass-circle-of-the-land.level-6-natural-recovery.p-2",
      "text": "In addition, when you finish a Short Rest, you can choose expended spell slots to recover. The spell slots can have a combined level that is equal to or less than half your Druid level (round up), and none of them can be level 6+. For example, if you’re a level 6 Druid, you can recover up to three levels’ worth of spell slots. You can recover a level 3 spell slot, a level 2 and a level 1 spell slot, or three level 1 spell slots. Once you recover spell slots with this feature, you can’t do so again until you finish a Long Rest.",
      "type": "paragraph"
    },
    {
      "level": 4,
      "ruleId": "classes.druid.druid-subclass-circle-of-the-land.level-10-natures-ward",
      "text": "Level 10: Nature’s Ward",
      "type": "heading"
    },
    {
      "ruleId": "classes.druid.druid-subclass-circle-of-the-land.level-10-natures-ward.p-1",
      "text": "You are immune to the Poisoned condition, and you have Resistance to a damage type associated with your current land choice in the Circle Spells feature, as shown in the Nature’s Ward table.",
      "type": "paragraph"
    },
    {
      "caption": "Nature’s Ward",
      "columns": [
        "Land Type",
        "Resistance",
        "Land Type",
        "Resistance"
      ],
      "rows": [
        [
          "Arid",
          "Fire",
          "Temperate",
          "Lightning"
        ],
        [
          "Polar",
          "Cold",
          "Tropical",
          "Poison"
        ]
      ],
      "ruleId": "classes.druid.druid-subclass-circle-of-the-land.level-10-natures-ward.table-1",
      "type": "table"
    },
    {
      "level": 4,
      "ruleId": "classes.druid.druid-subclass-circle-of-the-land.level-14-natures-sanctuary",
      "text": "Level 14: Nature’s Sanctuary",
      "type": "heading"
    },
    {
      "ruleId": "classes.druid.druid-subclass-circle-of-the-land.level-14-natures-sanctuary.p-1",
      "text": "As a Magic action, you can expend a use of your Wild Shape and cause spectral trees and vines to appear in a 15-foot Cube on the ground within 120 feet of yourself. They last there for 1 minute or until you have the Incapacitated condition or die. You and your allies have Half Cover while in that area, and your allies gain the current Resistance of your Nature’s Ward while there.",
      "type": "paragraph"
    },
    {
      "ruleId": "classes.druid.druid-subclass-circle-of-the-land.level-14-natures-sanctuary.p-2",
      "text": "As a Bonus Action, you can move the Cube up to 60 feet to ground within 120 feet of yourself.",
