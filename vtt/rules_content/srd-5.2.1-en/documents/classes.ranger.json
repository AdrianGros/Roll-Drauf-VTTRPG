    {
      "level": 3,
      "ruleId": "classes.ranger.ranger-subclass-hunter",
      "text": "Ranger Subclass: Hunter",
      "type": "heading"
    },
    {
      "level": 4,
      "ruleId": "classes.ranger.ranger-subclass-hunter.protect-nature-and-people-from-destruction",
      "text": "Protect Nature and People from Destruction",
      "type": "heading"
    },
    {
      "ruleId": "classes.ranger.ranger-subclass-hunter.protect-nature-and-people-from-destruction.p-1",
      "text": "You stalk prey in the wilds and elsewhere, using your abilities as a Hunter to protect nature and people everywhere from forces that would destroy them.",
      "type": "paragraph"
    },
    {
      "level": 4,
      "ruleId": "classes.ranger.ranger-subclass-hunter.level-3-hunters-lore",
      "text": "Level 3: Hunter’s Lore",
      "type": "heading"
    },
    {
      "ruleId": "classes.ranger.ranger-subclass-hunter.level-3-hunters-lore.p-1",
      "text": "You can call on the forces of nature to reveal certain strengths and weaknesses of your prey. While a creature is marked by your Hunter’s Mark, you know whether that creature has any Immunities, Resistances, or Vulnerabilities, and if the creature has any, you know what they are.",
      "type": "paragraph"
    },
    {
      "level": 4,
      "ruleId": "classes.ranger.ranger-subclass-hunter.level-3-hunters-prey",
      "text": "Level 3: Hunter’s Prey",
      "type": "heading"
    },
    {
      "ruleId": "classes.ranger.ranger-subclass-hunter.level-3-hunters-prey.p-1",
      "text": "You gain one of the following feature options of your choice. Whenever you finish a Short or Long Rest, you can replace the chosen option with the other one.",
      "type": "paragraph"
    },
    {
      "ruleId": "classes.ranger.ranger-subclass-hunter.level-3-hunters-prey.p-2",
      "text": "Colossus Slayer. Your tenacity can wear down even the most resilient foes. When you hit a creature with a weapon, the weapon deals an extra 1d8 damage to the target if it’s missing any of its Hit Points. You can deal this extra damage only once per turn.",
      "type": "paragraph"
    },
    {
      "ruleId": "classes.ranger.ranger-subclass-hunter.level-3-hunters-prey.p-3",
      "text": "Horde Breaker. Once on each of your turns when you make an attack with a weapon, you can make another attack with the same weapon against a different creature that is within 5 feet of the original target, that is within the weapon’s range, and that you haven’t attacked this turn.",
      "type": "paragraph"
    },
    {
      "level": 4,
      "ruleId": "classes.ranger.ranger-subclass-hunter.level-7-defensive-tactics",
      "text": "Level 7: Defensive Tactics",
      "type": "heading"
    },
    {
      "ruleId": "classes.ranger.ranger-subclass-hunter.level-7-defensive-tactics.p-1",
      "text": "You gain one of the following feature options of your choice. Whenever you finish a Short or Long Rest, you can replace the chosen option with the other one.",
      "type": "paragraph"
    },
    {
      "ruleId": "classes.ranger.ranger-subclass-hunter.level-7-defensive-tactics.p-2",
      "text": "Escape the Horde. Opportunity Attacks have Disadvantage against you.",
      "type": "paragraph"
    },
    {
      "ruleId": "classes.ranger.ranger-subclass-hunter.level-7-defensive-tactics.p-3",
      "text": "Multiattack Defense. When a creature hits you with an attack roll, that creature has Disadvantage on all other attack rolls against you this turn.",
      "type": "paragraph"
    },
    {
      "level": 4,
      "ruleId": "classes.ranger.ranger-subclass-hunter.level-11-superior-hunters-prey",
      "text": "Level 11: Superior Hunter’s Prey",
      "type": "heading"
    },
    {
      "ruleId": "classes.ranger.ranger-subclass-hunter.level-11-superior-hunters-prey.p-1",
      "text": "Once per turn when you deal damage to a creature marked by your Hunter’s Mark, you can also deal that spell’s extra damage to a different creature that you can see within 30 feet of the first creature.",
      "type": "paragraph"
    },
    {
      "level": 4,
      "ruleId": "classes.ranger.ranger-subclass-hunter.level-15-superior-hunters-defense",
      "text": "Level 15: Superior Hunter’s Defense",
      "type": "heading"
    },
    {
      "ruleId": "classes.ranger.ranger-subclass-hunter.level-15-superior-hunters-defense.p-1",
      "text": "When you take damage, you can take a Reaction to give yourself Resistance to that damage and any other damage of the same type until the end of the current turn.",
      "type": "paragraph"
    }
  ],
