{
  "blocks": [
    {
      "level": 2,
      "ruleId": "origins.backgrounds",
      "text": "Character Origins",
      "type": "heading"
    },
    {
      "editorial": true,
      "ruleId": "origins.backgrounds.roll-drauf-note",
      "text": "A background describes where a character comes from. It provides ability score increases, an Origin feat, skill and tool proficiencies, and starting equipment. Four backgrounds are presented.",
      "title": "Roll Drauf reading note",
      "type": "original-note"
    },
    {
      "level": 2,
      "ruleId": "origins.backgrounds.character-backgrounds",
      "text": "Character Backgrounds",
      "type": "heading"
    },
    {
      "ruleId": "origins.backgrounds.character-backgrounds.p-1",
      "text": "Your character’s background is a collection of characteristics that represent the place and occupation that were most formative before your character embarked on a life of adventure.",
      "type": "paragraph"
    },
    {
      "level": 4,
      "ruleId": "origins.backgrounds.character-backgrounds.parts-of-a-background",
      "text": "Parts of a Background",
      "type": "heading"
    },
    {
      "ruleId": "origins.backgrounds.character-backgrounds.parts-of-a-background.p-1",
      "text": "A background includes the following parts.",
      "type": "paragraph"
    },
    {
      "level": 4,
      "ruleId": "origins.backgrounds.character-backgrounds.ability-scores",
      "text": "Ability Scores",
      "type": "heading"
    },
    {
      "ruleId": "origins.backgrounds.character-backgrounds.ability-scores.p-1",
      "text": "A background lists three of your character’s ability scores. Increase one by 2 and another one by 1, or increase all three by 1. None of these increases can raise a score above 20.",
      "type": "paragraph"
    },
    {
      "level": 4,
      "ruleId": "origins.backgrounds.character-backgrounds.feat",
      "text": "Feat",
      "type": "heading"
    },
    {
      "ruleId": "origins.backgrounds.character-backgrounds.feat.p-1",
      "text": "A background gives your character a specified Origin feat (described in “Feats”). Skill Proficiencies A background gives your character proficiency in two specified skills.",
      "type": "paragraph"
    },
    {
      "level": 4,
      "ruleId": "origins.backgrounds.character-backgrounds.tool-proficiency",
      "text": "Tool Proficiency",
      "type": "heading"
    },
    {
      "ruleId": "origins.backgrounds.character-backgrounds.tool-proficiency.p-1",
      "text": "Each background gives a character proficiency with one tool—either a specific tool or one chosen from the Artisan’s Tools category. Tools are detailed in “Equipment.”",
      "type": "paragraph"
    },
    {
      "level": 4,
      "ruleId": "origins.backgrounds.character-backgrounds.equipment",
      "text": "Equipment",
      "type": "heading"
    },
    {
      "ruleId": "origins.backgrounds.character-backgrounds.equipment.p-1",
      "text": "Each background offers a choice between a package of equipment and 50 GP.",
      "type": "paragraph"
    },
    {
      "level": 4,
      "ruleId": "origins.backgrounds.character-backgrounds.background-descriptions",
      "text": "Background Descriptions",
      "type": "heading"
    },
