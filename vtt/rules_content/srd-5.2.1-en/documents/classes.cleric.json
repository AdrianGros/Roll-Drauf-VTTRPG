    },
    {
      "level": 3,
      "ruleId": "classes.cleric.cleric-class-features",
      "text": "Cleric Class Features",
      "type": "heading"
    },
    {
      "ruleId": "classes.cleric.cleric-class-features.p-1",
      "text": "As a Cleric, you gain the following class features when you reach the specified Cleric levels. These features are listed in the Cleric Features table.",
      "type": "paragraph"
    },
    {
      "level": 4,
      "ruleId": "classes.cleric.cleric-class-features.level-1-spellcasting",
      "text": "Level 1: Spellcasting",
      "type": "heading"
    },
    {
      "ruleId": "classes.cleric.cleric-class-features.level-1-spellcasting.p-1",
      "text": "You have learned to cast spells through prayer and meditation. See “Spells” for the rules on spellcasting. The information below details how you use those rules with Cleric spells, which appear on the Cleric spell list later in the class’s description.",
      "type": "paragraph"
    },
    {
      "ruleId": "classes.cleric.cleric-class-features.level-1-spellcasting.p-2",
      "text": "Cantrips. You know three cantrips of your choice from the Cleric spell list. Guidance, Sacred Flame, and Thaumaturgy are recommended.",
      "type": "paragraph"
    },
    {
      "ruleId": "classes.cleric.cleric-class-features.level-1-spellcasting.p-3",
      "text": "Whenever you gain a Cleric level, you can replace one of your cantrips with another cantrip of your choice from the Cleric spell list.",
      "type": "paragraph"
    },
