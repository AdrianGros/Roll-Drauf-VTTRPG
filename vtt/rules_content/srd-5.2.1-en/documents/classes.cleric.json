    {
      "level": 3,
      "ruleId": "classes.cleric.cleric-subclass-life-domain",
      "text": "Cleric Subclass: Life Domain",
      "type": "heading"
    },
    {
      "level": 4,
      "ruleId": "classes.cleric.cleric-subclass-life-domain.soothe-the-hurts-of-the-world",
      "text": "Soothe the Hurts of the World",
      "type": "heading"
    },
    {
      "ruleId": "classes.cleric.cleric-subclass-life-domain.soothe-the-hurts-of-the-world.p-1",
      "text": "The Life Domain focuses on the positive energy that helps sustain all life in the multiverse. Clerics who tap into this domain are masters of healing, using that life force to cure many hurts.",
      "type": "paragraph"
    },
    {
      "ruleId": "classes.cleric.cleric-subclass-life-domain.soothe-the-hurts-of-the-world.p-2",
      "text": "Existence itself relies on the positive energy associated with this domain, so a Cleric of almost any religious tradition might choose it. This domain is particularly associated with agricultural deities, gods of healing or endurance, and gods of home and community. Religious orders of healing also seek the magic of this domain.",
      "type": "paragraph"
    },
    {
      "level": 4,
      "ruleId": "classes.cleric.cleric-subclass-life-domain.level-3-disciple-of-life",
      "text": "Level 3: Disciple of Life",
      "type": "heading"
    },
    {
      "ruleId": "classes.cleric.cleric-subclass-life-domain.level-3-disciple-of-life.p-1",
      "text": "When a spell you cast with a spell slot restores Hit Points to a creature, that creature regains additional Hit Points on the turn you cast the spell. The additional Hit Points equal 2 plus the spell slot’s level.",
      "type": "paragraph"
    },
    {
      "level": 4,
      "ruleId": "classes.cleric.cleric-subclass-life-domain.level-3-life-domain-spells",
      "text": "Level 3: Life Domain Spells",
      "type": "heading"
    },
    {
      "ruleId": "classes.cleric.cleric-subclass-life-domain.level-3-life-domain-spells.p-1",
      "text": "Your connection to this divine domain ensures you always have certain spells ready. When you reach a Cleric level specified in the Life Domain Spells table, you thereafter always have the listed spells prepared.",
      "type": "paragraph"
    },
    {
      "caption": "Life Domain Spells",
      "columns": [
        "Cleric",
        "Prepared Spells"
      ],
      "rows": [],
      "ruleId": "classes.cleric.cleric-subclass-life-domain.level-3-life-domain-spells.table-1",
      "type": "table"
    },
    {
      "caption": "Level",
      "columns": [
        "3",
        "Aid, Bless, Cure Wounds,"
      ],
      "rows": [
        [
          "",
          "Lesser Restoration"
        ],
        [
          "5",
          "Mass Healing Word, Revivify"
        ],
        [
          "7",
          "Aura of Life, Death Ward"
        ],
        [
          "9",
          "Greater Restoration, Mass Cure Wounds"
        ]
      ],
      "ruleId": "classes.cleric.cleric-subclass-life-domain.level-3-life-domain-spells.table-2",
      "type": "table"
    },
    {
      "level": 4,
      "ruleId": "classes.cleric.cleric-subclass-life-domain.level-3-preserve-life",
      "text": "Level 3: Preserve Life",
      "type": "heading"
    },
    {
      "ruleId": "classes.cleric.cleric-subclass-life-domain.level-3-preserve-life.p-1",
      "text": "As a Magic action, you present your Holy Symbol and expend a use of your Channel Divinity to evoke healing energy that can restore a number of Hit Points equal to five times your Cleric level. Choose Bloodied creatures within 30 feet of yourself (which can include you), and divide those Hit Points among them. This feature can restore a creature to no more than half its Hit Point maximum.",
      "type": "paragraph"
    },
    {
      "level": 4,
      "ruleId": "classes.cleric.cleric-subclass-life-domain.level-6-blessed-healer",
      "text": "Level 6: Blessed Healer",
      "type": "heading"
    },
    {
      "ruleId": "classes.cleric.cleric-subclass-life-domain.level-6-blessed-healer.p-1",
      "text": "The healing spells you cast on others heal you as well. Immediately after you cast a spell with a spell slot that restores Hit Points to one or more creatures other than yourself, you regain Hit Points equal to 2 plus the spell slot’s level.",
      "type": "paragraph"
    },
    {
      "level": 4,
      "ruleId": "classes.cleric.cleric-subclass-life-domain.level-17-supreme-healing",
      "text": "Level 17: Supreme Healing",
      "type": "heading"
    },
    {
      "ruleId": "classes.cleric.cleric-subclass-life-domain.level-17-supreme-healing.p-1",
      "text": "When you would normally roll one or more dice to restore Hit Points to a creature with a spell or Channel Divinity, don’t roll those dice for the healing; instead use the highest number possible for each die. For example, instead of restoring 2d6 Hit Points to a creature with a spell, you restore 12.",
      "type": "paragraph"
    }
  ],
