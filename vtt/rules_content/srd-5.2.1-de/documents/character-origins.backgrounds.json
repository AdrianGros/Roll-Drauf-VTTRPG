  "contentStatus": "verbatim",
  "blocks": [
    {
      "type": "heading",
      "ruleId": "character-origins.backgrounds.character-backgrounds",
      "level": 2,
      "text": "Charakterhintergründe"
    },
    {
      "type": "paragraph",
      "ruleId": "character-origins.backgrounds.character-backgrounds-introduction",
      "text": "Der Hintergrund deines Charakters ist eine Sammlung von Eigenschaften, die den prägendsten Lebensort und Beruf deines Charakter vor seinem Abenteurerleben repräsentieren."
    },
    {
      "type": "heading",
      "ruleId": "character-origins.backgrounds.background-elements",
      "level": 3,
      "text": "Elemente eines Hintergrunds"
    },
    {
      "type": "paragraph",
      "ruleId": "character-origins.backgrounds.background-elements-introduction",
      "text": "Zu einem Hintergrund gehören folgende Elemente:"
    },
    {
      "type": "heading",
      "ruleId": "character-origins.backgrounds.background-ability-scores",
      "level": 4,
      "text": "Attributswerte"
    },
    {
      "type": "paragraph",
      "ruleId": "character-origins.backgrounds.background-ability-scores-description",
      "text": "In einem Hintergrund sind drei der Attributswerte deines Charakters aufgeführt. Erhöhe einen davon um 2 und einen anderen um 1, oder alle drei um 1. Keine dieser Erhöhungen kann zu einem Wert von mehr als 20 führen."
    },
    {
      "type": "heading",
      "ruleId": "character-origins.backgrounds.background-feat",
      "level": 4,
      "text": "Talent"
    },
    {
      "type": "paragraph",
      "ruleId": "character-origins.backgrounds.background-feat-description",
      "text": "Ein Hintergrund gibt deinem Charakter ein bestimmtes Herkunftstalent (siehe „Talente“)."
    },
    {
      "type": "heading",
      "ruleId": "character-origins.backgrounds.background-skill-proficiencies",
      "level": 4,
      "text": "Fertigkeiten, in denen du geübt bist"
    },
    {
      "type": "paragraph",
      "ruleId": "character-origins.backgrounds.background-skill-proficiencies-description",
      "text": "Ein Hintergrund gibt deinem Charakter Übung in zwei bestimmten Fertigkeiten."
    },
    {
      "type": "heading",
      "ruleId": "character-origins.backgrounds.background-tool-proficiency",
      "level": 4,
      "text": "Übung im Umgang mit Werkzeug"
    },
    {
      "type": "paragraph",
      "ruleId": "character-origins.backgrounds.background-tool-proficiency-description",
      "text": "Jeder Hintergrund gibt einem Charakter Übung im Umgang mit einem Werkzeug – entweder mit einem bestimmten Werkzeug oder einem Werkzeug, das aus der Kategorie „Handwerkszeug“ ausgewählt wird. Werkzeuge sind unter „Ausrüstung“ beschrieben."
    },
    {
      "type": "heading",
      "ruleId": "character-origins.backgrounds.background-equipment",
      "level": 4,
      "text": "Ausrüstung"
    },
    {
      "type": "paragraph",
      "ruleId": "character-origins.backgrounds.background-equipment-description",
      "text": "Jeder Hintergrund bietet die Wahl zwischen einem Ausrüstungspaket oder 50 GM."
    },
    {
      "type": "heading",
      "ruleId": "character-origins.backgrounds.background-descriptions",
      "level": 3,
      "text": "Beschreibungen der Hintergründe"
    },
    {
      "type": "heading",
      "ruleId": "character-origins.backgrounds.acolyte",
      "level": 4,
      "text": "Akolyth"
    },
    {
      "type": "definition-list",
      "ruleId": "character-origins.backgrounds.acolyte-traits",
      "entries": [
        {
          "term": "Attributswerte",
          "definition": "Intelligenz, Weisheit, Charisma"
        },
        {
          "term": "Talent",
          "definition": "Eingeweihter der Magie (Kleriker) (siehe „Talente“)"
        },
        {
          "term": "Fertigkeiten, in denen du geübt bist",
          "definition": "Motiv erkennen und Religion"
        },
        {
          "term": "Übung im Umgang mit Werkzeug",
          "definition": "Kalligrafiewerkzeug"
        },
        {
          "term": "Ausrüstung",
          "definition": "Wähle A oder B aus: (A) Kalligrafiewerkzeug, Buch (Gebete), Heiliges Symbol, Pergament (10 Blätter), Robe und 8 GM oder (B) 50 GM"
        }
      ]
    },
    {
      "type": "heading",
      "ruleId": "character-origins.backgrounds.criminal",
      "level": 4,
      "text": "Krimineller"
    },
    {
      "type": "definition-list",
      "ruleId": "character-origins.backgrounds.criminal-traits",
      "entries": [
        {
          "term": "Attributswerte",
          "definition": "Geschicklichkeit, Konstitution, Intelligenz"
        },
        {
          "term": "Talent",
          "definition": "Wachsam (siehe „Talente“)"
        },
        {
          "term": "Fertigkeiten, in denen du geübt bist",
          "definition": "Fingerfertigkeit und Heimlichkeit"
        },
        {
          "term": "Übung im Umgang mit Werkzeug",
          "definition": "Diebeswerkzeug"
        },
        {
          "term": "Ausrüstung",
          "definition": "Wähle A oder B aus: (A) Zwei Dolche, Diebeswerkzeug, Brechstange, zwei Beutel, Reisekleidung und 16 GM oder (B) 50 GM"
        }
      ]
    },
    {
      "type": "heading",
      "ruleId": "character-origins.backgrounds.soldier",
      "level": 4,
      "text": "Soldat"
    },
    {
      "type": "definition-list",
      "ruleId": "character-origins.backgrounds.soldier-traits",
      "entries": [
        {
          "term": "Attributswerte",
          "definition": "Stärke, Geschicklichkeit, Konstitution"
        },
        {
          "term": "Talent",
          "definition": "Wilder Angreifer (siehe „Talente“)"
        },
        {
          "term": "Fertigkeiten, in denen du geübt bist",
          "definition": "Athletik und Einschüchtern"
        },
        {
          "term": "Übung im Umgang mit Werkzeug",
          "definition": "Wähle eine Art von Spielset aus (siehe „Ausrüstung“)"
        },
        {
          "term": "Ausrüstung",
          "definition": "Wähle A oder B aus: (A) Speer, Kurzbogen, 20 Pfeile, Spielset (wie oben), Heilerausrüstung, Köcher, Reisekleidung und 14 GM oder (B) 50 GM"
        }
      ]
    },
    {
      "type": "heading",
      "ruleId": "character-origins.backgrounds.sage",
      "level": 4,
      "text": "Weiser"
    },
    {
      "type": "definition-list",
      "ruleId": "character-origins.backgrounds.sage-traits",
      "entries": [
        {
          "term": "Attributswerte",
          "definition": "Konstitution, Intelligenz, Weisheit"
        },
        {
          "term": "Talent",
          "definition": "Eingeweihter der Magie (Magier) (siehe „Talente“)"
        },
        {
          "term": "Fertigkeiten, in denen du geübt bist",
          "definition": "Arkane Kunde und Geschichte"
        },
        {
          "term": "Übung im Umgang mit Werkzeug",
          "definition": "Kalligrafiewerkzeug"
        },
        {
          "term": "Ausrüstung",
          "definition": "Wähle A oder B aus: (A) Kampfstab, Kalligrafiewerkzeug, Buch (Geschichte), Pergament (8 Blätter), Robe und 8 GM oder (B) 50 GM"
        }
      ]
    }
  ],
