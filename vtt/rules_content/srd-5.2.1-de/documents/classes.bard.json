          "definition": "1W8 pro Bardenstufe"
        },
        {
          "term": "Rettungswürfe, in denen du geübt bist",
          "definition": "Geschicklichkeit und Charisma"
        },
        {
          "term": "Fertigkeiten, in denen du geübt bist",
          "definition": "Drei Fertigkeiten deiner Wahl (siehe „Die Spielregeln“)"
        },
        {
          "term": "Übung im Umgang mit Waffen",
          "definition": "Einfache Waffen"
        },
        {
          "term": "Übung im Umgang mit Werkzeug",
          "definition": "Drei Musikinstrumente deiner Wahl (siehe „Ausrüstung“)"
        },
        {
          "term": "Rüstungsvertrautheit",
          "definition": "Leichte Rüstung"
        },
        {
          "term": "Anfangsausrüstung",
          "definition": "Wähle A oder B aus: (A) Lederrüstung, zwei Dolche, Musikinstrument deiner Wahl, Unterhaltungskünstler-Ausrüstung und 19 GM oder (B) 90 GM"
        }
      ]
    },
