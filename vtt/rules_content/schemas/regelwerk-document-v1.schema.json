{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rolldrauf:regelwerk:document:v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "rulesetId",
    "documentId",
    "slug",
    "title",
    "navigationPath",
    "order",
    "sourcePages",
    "contentStatus",
    "blocks",
    "ruleRefs",
    "digest"
  ],
  "properties": {
    "schemaVersion": {
      "const": "regelwerk.document.v1"
    },
    "rulesetId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$",
      "maxLength": 80
    },
    "documentId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "maxLength": 160
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 160
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "navigationPath": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    },
    "order": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000
    },
    "sourcePages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 1,
        "maximum": 10000
      }
    },
    "contentStatus": {
      "enum": ["verbatim", "format-only", "adapted", "original"]
    },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5000,
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/heading" },
          { "$ref": "#/$defs/paragraph" },
          { "$ref": "#/$defs/list" },
          { "$ref": "#/$defs/definitionList" },
          { "$ref": "#/$defs/table" },
          { "$ref": "#/$defs/textCallout" },
          { "$ref": "#/$defs/statBlock" },
          { "$ref": "#/$defs/originalNote" }
        ]
      }
    },
    "ruleRefs": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 2000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rulesetId", "ruleId", "label"],
        "properties": {
          "rulesetId": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$",
            "maxLength": 80
          },
          "ruleId": {
            "$ref": "#/$defs/ruleId"
          },
          "label": {
            "$ref": "#/$defs/shortText"
          }
        }
      }
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  },
  "$defs": {
    "ruleId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "maxLength": 240
    },
    "shortText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "longText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "heading": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "ruleId", "level", "text"],
      "properties": {
        "type": { "const": "heading" },
        "ruleId": { "$ref": "#/$defs/ruleId" },
        "level": { "type": "integer", "minimum": 2, "maximum": 6 },
        "text": { "$ref": "#/$defs/shortText" }
      }
    },
    "paragraph": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "ruleId", "text"],
      "properties": {
        "type": { "const": "paragraph" },
        "ruleId": { "$ref": "#/$defs/ruleId" },
        "text": { "$ref": "#/$defs/longText" }
      }
    },
    "list": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "ruleId", "items"],
      "properties": {
        "type": { "enum": ["ordered-list", "unordered-list"] },
        "ruleId": { "$ref": "#/$defs/ruleId" },
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 500,
          "items": { "$ref": "#/$defs/longText" }
        }
      }
    },
    "definitionList": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "ruleId", "entries"],
      "properties": {
        "type": { "const": "definition-list" },
        "ruleId": { "$ref": "#/$defs/ruleId" },
        "entries": {
          "type": "array",
          "minItems": 1,
          "maxItems": 500,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["term", "definition"],
            "properties": {
              "term": { "$ref": "#/$defs/shortText" },
              "definition": { "$ref": "#/$defs/longText" }
            }
          }
        }
      }
    },
    "table": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "ruleId", "caption", "columns", "rows"],
      "properties": {
        "type": { "const": "table" },
        "ruleId": { "$ref": "#/$defs/ruleId" },
        "caption": { "$ref": "#/$defs/shortText" },
        "columns": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": { "$ref": "#/$defs/shortText" }
        },
        "rows": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5000,
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "items": { "$ref": "#/$defs/longText" }
          }
        }
      }
    },
    "textCallout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "ruleId", "text"],
      "properties": {
        "type": { "enum": ["rule-callout", "page-note"] },
        "ruleId": { "$ref": "#/$defs/ruleId" },
        "title": { "$ref": "#/$defs/shortText" },
        "text": { "$ref": "#/$defs/longText" }
      }
    },
    "statBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "ruleId", "name", "entries", "sections"],
      "properties": {
        "type": { "const": "stat-block" },
        "ruleId": { "$ref": "#/$defs/ruleId" },
        "name": { "$ref": "#/$defs/shortText" },
        "entries": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label", "value"],
            "properties": {
              "label": { "$ref": "#/$defs/shortText" },
              "value": { "$ref": "#/$defs/longText" }
            }
          }
        },
        "sections": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["title", "text"],
            "properties": {
              "title": { "$ref": "#/$defs/shortText" },
              "text": { "$ref": "#/$defs/longText" }
            }
          }
        }
      }
    },
    "originalNote": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "ruleId", "title", "text"],
      "properties": {
        "type": { "const": "original-note" },
        "ruleId": { "$ref": "#/$defs/ruleId" },
        "title": { "$ref": "#/$defs/shortText" },
        "text": { "$ref": "#/$defs/longText" }
      }
    }
  }
}
