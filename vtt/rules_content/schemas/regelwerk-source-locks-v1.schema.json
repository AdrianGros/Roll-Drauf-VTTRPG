{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rolldrauf:regelwerk:source-locks:v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "sources"],
  "properties": {
    "schemaVersion": {
      "const": "regelwerk.source-locks.v1"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rulesetId",
          "sourceTitle",
          "sourcePublicationDate",
          "retrievedAt",
          "sourceUrl",
          "sourceSha256",
          "sourcePageCount",
          "licenseId",
          "licenseUrl",
          "attributionFile",
          "attributionSha256"
        ],
        "properties": {
          "rulesetId": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$",
            "maxLength": 80
          },
          "sourceTitle": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "sourcePublicationDate": {
            "type": "string",
            "format": "date"
          },
          "retrievedAt": {
            "type": "string",
            "format": "date"
          },
          "sourceUrl": {
            "type": "string",
            "format": "uri",
            "maxLength": 500
          },
          "sourceSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "sourcePageCount": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10000
          },
          "licenseId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9.-]+$",
            "maxLength": 50
          },
          "licenseUrl": {
            "type": "string",
            "format": "uri",
            "maxLength": 500
          },
          "attributionFile": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]*$",
            "maxLength": 100
          },
          "attributionSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    }
  }
}
