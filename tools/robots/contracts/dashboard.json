{
  "page": "dashboard",
  "path": "/dashboard",
  "ready": "#book-dashboard-scene",
  "_hinweis": "Die sichtbare Navigation wird von book-scene.js gerendert (ohne onclick/data-book-route); das Template-Ribbon in dashboard.html ist verstecktes Alt-Markup mit onclick. Deshalb wählt :not([onclick]) plus Textfilter die Live-Elemente. B3 räumt das Doppel-Markup ab; danach bekommen die Live-Knöpfe data-testid (§13) und diese Selektoren werden ersetzt. effect:any-Verträge sind Mindestverträge (§2 kein toter Knopf) — in B3 durch präzise Nachbedingungen ersetzen.",
  "elements": [
    {
      "id": "ribbon-overview",
      "selector": ".book-dashboard-ribbon-btn:not([onclick])",
      "text": "Übersicht",
      "label": "Lesebändchen: Übersicht",
      "kind": "nav",
      "engines": ["mouse", "keyboard"],
      "expect": {"route": "/dashboard"},
      "severity": "blocker"
    },
    {
      "id": "ribbon-campaigns",
      "selector": ".book-dashboard-ribbon-btn:not([onclick])",
      "text": "Kampagnen",
      "label": "Lesebändchen: Kampagnen",
      "kind": "nav",
      "engines": ["mouse", "keyboard"],
      "expect": {"route": "/campaigns"},
      "severity": "blocker"
    },
    {
      "id": "ribbon-characters",
      "selector": ".book-dashboard-ribbon-btn:not([onclick])",
      "text": "Charaktere",
      "label": "Lesebändchen: Charaktere",
      "kind": "nav",
      "engines": ["mouse", "keyboard"],
      "expect": {"route": "/characters"},
      "severity": "blocker"
    },
    {
      "id": "ribbon-play",
      "selector": ".book-dashboard-ribbon-btn--play:not([onclick])",
      "label": "Lesebändchen: Spieltisch",
      "kind": "nav",
      "engines": ["mouse"],
      "expect": {"effect": "any"},
      "severity": "high"
    },
    {
      "id": "ribbon-logout",
      "selector": ".book-dashboard-ribbon-btn:not([onclick])",
      "text": "Abmelden",
      "label": "Lesebändchen: Abmelden",
      "kind": "auth",
      "engines": ["mouse"],
      "expect": {"route": "/login"},
      "severity": "blocker",
      "resets_auth": true
    },
    {
