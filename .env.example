# Flask
FLASK_ENV=development
FLASK_DEBUG=True

# Database
DATABASE_URL=sqlite:///vtt.db
# For production: postgresql://user:password@localhost/vtt_db

# JWT
JWT_SECRET_KEY=your-secret-key-change-this-in-production
SECRET_KEY=your-flask-secret-key-change-this-in-production

# Redis / Realtime / Rate limiting
REDIS_URL=redis://localhost:6379/0
SOCKETIO_MESSAGE_QUEUE=redis://localhost:6379/0
RATELIMIT_STORAGE_URL=redis://localhost:6379/1

# CORS
CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000

# Ops
LOG_JSON=True
METRICS_ENABLED=True
AUTO_CREATE_SCHEMA=True
RATELIMIT_SWALLOW_ERRORS=True
VOICE_ENABLED=False

# Discord OAuth2 / Bot-backed login
DISCORD_LOGIN_ENABLED=False
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:5000/api/auth/discord/callback
DISCORD_AUTHORIZATION_BASE_URL=https://discord.com/oauth2/authorize
DISCORD_TOKEN_URL=https://discord.com/api/oauth2/token
DISCORD_API_BASE_URL=https://discord.com/api/v10
DISCORD_OAUTH_SCOPES=identify,email
DISCORD_GUILD_ID=
DISCORD_BOT_VERIFICATION_URL=
DISCORD_BOT_SHARED_SECRET=
DISCORD_REQUEST_TIMEOUT_SECONDS=10

# Server
HOST=0.0.0.0
PORT=5000
