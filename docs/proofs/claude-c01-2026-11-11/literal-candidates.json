  {
    "file": "vtt/static/js/book-scene.js",
    "source": "Der Buchzugang öffnet ruhig, bevor das erste Kapitel sichtbar wird.",
    "start": 20913,
    "end": 20982
  },
  {
    "file": "vtt/static/js/book-scene.js",
    "source": "Die Registrierung bleibt im selben Buch und führt klar durch die Kontoanlage.",
    "start": 21104,
    "end": 21183
  },
  {
    "file": "vtt/static/js/book-scene.js",
    "source": "Das nächste Blatt erklärt die Registrierung, ohne den Buchrahmen zu verlassen.",
    "start": 21206,
    "end": 21286
  },
  {
    "file": "vtt/static/js/book-scene.js",
    "source": "Die Einladungsseite bleibt im selben Buch, damit der erste geschützte Abschnitt direkt folgen kann.",
    "start": 21410,
    "end": 21511
  },
  {
    "file": "vtt/static/js/book-scene.js",
    "source": "Das Dashboard ist der Startpunkt für Kampagnen, Charaktere und den nächsten Weg in die Session-Vorbereitung.",
    "start": 21725,
    "end": 21835
  },
  {
    "file": "vtt/static/js/book-scene.js",
    "source": "Das Dashboard öffnet die stabile Vorbereitungsroute vor dem Tisch.",
    "start": 21858,
    "end": 21926
  },
  {
    "file": "vtt/static/js/book-scene.js",
    "source": "In Kampagnen legst du neue Runden an, öffnest den Hub und gehst weiter in Session-Prep.",
    "start": 22047,
    "end": 22136
  },
  {
    "file": "vtt/static/js/book-scene.js",
    "source": "Kampagnen ist der direkte Weg von der Übersicht in Hub, Session-Prep und Play.",
    "start": 22159,
    "end": 22239
  },
  {
    "file": "vtt/static/js/book-scene.js",
    "source": "Im Charakterarchiv legst du Helden an, pflegst Avatar und Token und öffnest den Bogen für den Feinschliff.",
    "start": 22361,
    "end": 22469
  },
  {
    "file": "vtt/static/js/book-scene.js",
    "source": "Charaktere ist der Ort für Heldenanlage, Identität und den Rückweg in die Session-Vorbereitung.",
    "start": 22492,
    "end": 22589
  },
  {
    "file": "vtt/static/js/book-scene.js",
    "source": "Der Bogen ist der nächste fokussierte Schritt innerhalb des Buches.",
